@model System.Collections.Generic.IEnumerable<TL.Engine.SDK.Integrations.Telegram.Bots.IBaseBot>
<h1>Запущенные боты:</h1>
<div class="table-responsive">
    <table class="table table-bordered table-hover table-responsive-stack">
        <thead class="thead-light">
            <tr>
                <th style="flex-basis: 5%">#</th>
                <th style="flex-basis: 15%">Имя</th>
                <th style="flex-basis: 15%">Тип</th>
                <th style="flex-basis: 20%">Время жизни</th>
                <th style="flex-basis: 15%">Ответов</th>
                <th style="flex-basis: 15%">Задержка</th>
                <th style="flex-basis: 15%">Убить</th>
            </tr>
        </thead>
        <tbody>
            @{
                var i = 1;
                foreach (var bot in Model)
                {
                    <tr>
                        <td style="flex-basis: 5%">@i</td>
                        <td style="flex-basis: 15%"><a href="https://t.me/@bot.Username" target="_blank">@@@bot.Username</a></td>
                        <td style="flex-basis: 15%">@bot.GetType().Name</td>
                        <td style="flex-basis: 20%">@bot.Uptime.Days д. @bot.Uptime.Hours ч. @bot.Uptime.Minutes м. @bot.Uptime.Seconds с.</td>
                        <td style="flex-basis: 15%">@bot.RequestSumaryCount</td>
                        <td style="flex-basis: 15%">@bot.PerformanceMs</td>
                        <td style="flex-basis: 15%">
                            <button class="btn btn-danger" onclick="kill('@bot.Username')">Убить</button>
                        </td>
                    </tr>
                    ++i;
                }
            }
        </tbody>
    </table>
</div>