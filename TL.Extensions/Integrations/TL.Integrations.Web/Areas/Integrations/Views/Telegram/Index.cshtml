@model TL.Integrations.Web.Areas.Integrations.ViewModels.Telegram.IndexViewModel

@{
    ViewData["Title"] = "Telegram";
}

<h1>Запустить бота:</h1>
<form id="formbot" asp-anti-forgery="true" class="needs-validation" novalidate>
    <div class="text-danger validation" asp-validation-summary="ModelOnly"></div>
    <div class="form-group">
        <label asp-for="@Model.Token">Токен Бота</label>
        <input id="token" type="text" asp-for="@Model.Token" class="form-control" placeholder="Токен" required />
        <div class="valid-feedback">
            Ок
        </div>
        <div class="invalid-feedback">
            Введите токен
        </div>
    </div>
    <div class="form-group">
        <label asp-for="@Model.BotType">Тип бота, пожалуйста</label>
        <select id="botType" asp-for="@Model.BotType" asp-items="@Model.AvailableTypes" class="form-control" required>
            <option disabled selected>Выберте один из вариантов</option>
        </select>
        <div class="valid-feedback">
            Ок
        </div>
        <div class="invalid-feedback">
            Выберите один из вариантов
        </div>
    </div>
    <div class="form-group form-check">
        <input id="quietStartup" class="form-check-input" type="checkbox" asp-for="@Model.QuietStartup" checked />
        <label class="form-check-label" asp-for="@Model.QuietStartup">Игнорировать пропущенные обновления при запуске</label>
    </div>
</form>
<div class="form-group">
    <button id="submit" class="btn btn-success" onclick="start($('#formbot').serialize())">
        Запустить
    </button>
</div>
<hr />
<div id="onlinebots">
    <partial name="_OnlineBots" model="@Model.Bots" />
</div>

@section Scripts {
    <script type="text/javascript">

        start = function (args) {
            $.ajax({
                url: '/integrations/telegram/start?' + args,
                type: 'post',
                success: function (result) {
                    $(document).find('#_StatusMessage').append(result);
                    $('#formbot').find('#token').val('');
                    $('#formbot').find('#botType').prop('selectedIndex', 0);
                    $('#formbot').find('#quietStartup').prop('checked', true);
                }
            })
        }

        kill = function (username) {
            $.ajax({
                url: "/integrations/telegram/kill?username=" + username,
                type: "post",
                success: function (result) {
                    $(document).find('#_StatusMessage').append(result);
                }
            });
        }

        update = function () {
            $.ajax({
                url: '/integrations/telegram/update',
                type: 'post',
                success: function (result) {
                    $(document).find('#onlinebots').html(result);
                }
            })
        }

        $(document).ready(function () {
            var hupdate = setInterval('update()', 500);
        })

    </script>
}