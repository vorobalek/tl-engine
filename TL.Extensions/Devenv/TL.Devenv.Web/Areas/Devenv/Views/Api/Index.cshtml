@{
    ViewData["Title"] = "API";
    Layout = "_Layout.cshtml";
}
<div class="col">
    <h1>Введение</h1>
    <p>
        С помощью <strong>TL Engine API</strong> вы можете получить доступ к нашим данным в удобном машинно-читаемом формате JSON.

        Для доступа к данным вы просто посылаете HTTPS-запрос по адресу:
        <pre><kbd>https://<code id="host1"></code>/api/{methodName}</kbd></pre>
        Параметры запроса зависят от метода.
        Вместе с описанием каждого
        <a href="./Api/Methods">метода</a> можно увидеть пример запроса.
    </p>
    <p>
        Формат ответа - JSON объект, который всегда содержит логическое поле
        <kbd>ok</kbd> и может иметь необязательное строковое поле
        <kbd>description</kbd> с описанием результата. Если поле
        <kbd>ok</kbd> равно
        <kbd>true</kbd>, запрос был выполнен успешно, в таком случае результат будет находиться в поле
        <kbd>result</kbd>. В случае неудачного запроса
        <kbd>ok</kbd> равно
        <kbd>false</kbd>, а ошибка приведена в поле
        <kbd>description</kbd>. Так же возвращается поле
        <kbd>errorСode</kbd>, чтобы помочь вам обрабатывать ошибки.
    </p>
    <h2>Пример удачного выполнения запроса</h2>
    <p>
        Запрос:
        <pre><kbd>HTTP GET https://<code id="host2"></code><code id="sampleGoodRequest"></code></kbd></pre>
        Ответ:
        <pre class="alert-success"><code id="sampleGoodResponse"></code></pre>
    </p>
    <h2>Пример неудачного выполнения запроса</h2>
    <p>
        Запрос:
        <pre><kbd>HTTP GET https://<code id="host3"></code><code id="sampleBadRequest"></code></kbd></pre>
        Ответ:
        <pre class="alert-danger"><code id="sampleBadResponse"></code></pre>
    </p>
</div>

@section Scripts {
    <script>
        var sampleGoodUri = '/api/test.Me';
        var sampleBadUri = '/api/test.Bad';
        var apiGetHostUri = '/api/test.Host';
        var alertMessage = 'В данный момент мы испытываем неполадки в работе системы API, данные на стрнице могут отображаться некорректно!';
        $(document).ready(function () {
            $('#sampleGoodRequest').text(sampleGoodUri);
            $('#sampleBadRequest').text(sampleBadUri);

            $.getJSON(sampleGoodUri)
                .done(function (data) {
                    $('#sampleGoodResponse')
                        .text(JSON.stringify(data, null, 2))
                })
                .fail(function () {
                    alert(err + '! ' + alertMessage);
                    $('#sampleGoodResponse')
                        .text(alertMessage)
                });

            $.getJSON(sampleBadUri)
                .done(function (data) {
                    $('#sampleBadResponse')
                        .text(JSON.stringify(data, null, 2))
                })
                .fail(function () {
                    alert(err + '! ' + alertMessage);
                    ('#sampleBadResponse')
                        .text(alertMessage)
                });

            $.getJSON(apiGetHostUri)
                .done(function (data) {
                    if (data.ok) {
                        $('#host1').text(data.result.value);
                        $('#host2').text(data.result.value);
                        $('#host3').text(data.result.value);
                    }
                })
                .fail(function (jqXHR, textok, err) {
                    alert(err + '! ' + alertMessage);
                    $('#host1').text(alertMessage);
                    $('#host2').text(alertMessage);
                    $('#host3').text(alertMessage);
                });
        });
    </script>
}