@model IEnumerable<TL.Engine.SDK.Modules.ModuleBase>
@{
    ViewData["Title"] = "Index";

    string f(TL.Engine.SDK.Modules.ModuleBase module)
    {
        var r = string.IsNullOrWhiteSpace(module.Url) 
            ? module.Name 
            : $"<a class=\"btn btn btn-outline-success btn-sm\" href=\"{module.Url}\" role=\"button\">{module.Name}</a>";
        if (module.SubModules.Any())
        {
            r += "<ul>";
            foreach (var sumodule in module.SubModules)
            {
                r += $"<li>{f(sumodule)}</li>";
            }
            r += "</ul>";
        }
        return r;
    }
}

<div class="jumbotron">
    <h1 class="display-4">Добро пожаловать!</h1>
    <p class="lead">Поздравляем с запуском TL Engine Enterprise!</p>
    <hr class="my-4">
    <p>
        Список доступных модулей TL Engine:
        <ul>
            @foreach (var module in Model)
            {
                <li>@Html.Raw(f(module))</li>
            }
        </ul>
    </p>
    <p class="lead">
        <a class="btn btn-primary btn-lg" href="~/Account" role="button">Go to Account</a>
    </p>
</div>
