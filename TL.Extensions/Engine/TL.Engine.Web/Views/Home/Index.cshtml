@model IEnumerable<TL.Engine.SDK.Modules.ModuleBase>
@{
    ViewData["Title"] = "Index";

    string globalModuleDivArea = "";

    string f(TL.Engine.SDK.Modules.ModuleBase module)
    {
        var moduleId = string.Join("_", module.Name.Split("."));
        var r = $"<span class=\"row align-items-center\">" +
                    $"<span class=\"col-auto\"><img src=\"{module.Icon}\" alt=\"Logo\"></span>" +
                    $"<button type=\"button\" class=\"btn btn-link\" data-toggle=\"modal\" data-target=\"#{moduleId}Modal\"><span class=\"glyphicon glyphicon-info-sign\"></span></button>" +
                    $"<h4>{module.Name}</h4>" +
                    $"</span>";
        globalModuleDivArea += GetModal(module);
        if (module.SubModules.Any())
        {
            r += $"<ul class=\"list-group\">";
            foreach (var submodule in module.SubModules)
            {
                r += "<li class=\"list-group-item\">";
                r += f(submodule);
                r += "</li>";
            }
            r += $"</ul>";
        }
        return r;
    }

    string GetModal(TL.Engine.SDK.Modules.ModuleBase module)
    {
        var moduleId = string.Join("_", module.Name.Split("."));
        var modalDivArea =
          $"<div class=\"modal fade\" id=\"{moduleId}Modal\" tabindex=\"-1\" role=\"dialog\" aria-labelledby=\"{moduleId}ModalTitle\" aria-hidden=\"true\">" +
              "<div class=\"modal-dialog modal-dialog-centered\" role=\"document\">" +
                  "<div class=\"modal-content\">" +
                      "<div class=\"modal-header\">" +
                          $"<h5 class=\"modal-title\" id=\"{moduleId}ModalLongTitle\">Подбробнее о модуле {module.Name}</h5>" +
                          "<button type=\"button\" class=\"close\" data-dismiss=\"modal\" aria-label=\"Close\">" +
                              "<span aria-hidden=\"true\">&times;</span>" +
                          "</button>" +
                      "</div>" +
                      "<div class=\"modal-body\">" +
                          "<p>" +
                              $"{@module.Description}" +
                          "</p>" +
                          "<p>" +
                              $"{@module.Authors}" +
                          "</p>" +
                          "<p>" +
                              $"version {module.Version}" +
                          "</p>" +
                      "</div>" +
                      "<div class=\"modal-footer\">" +
                          "<button type=\"button\" class=\"btn btn-secondary\" data-dismiss=\"modal\">Закрыть</button>";
        if (!string.IsNullOrWhiteSpace(module.Url))
        {
            modalDivArea += $"<a href=\"{module.Url}\" type=\"button\" class=\"btn btn-outline-dark\" role=\"button\">Перейти к модулю</a>";
        }
        else
        {
            modalDivArea += "<a href=\"#\" type=\"button\" class=\"btn btn-outline-dark\" role=\"button\">Веб-часть недоступна</a>";
        }
        modalDivArea += "</div>" +
                "</div>" +
            "</div>" +
        "</div>";

        return modalDivArea;
    }
}

<div>
    <h1 class="display-4">Добро пожаловать!</h1>
    <p class="lead">Поздравляем с запуском TL Engine Enterprise!</p>
    <hr class="my-4">
    <p>
        Список доступных модулей TL Engine:
    </p>
    <ul class="list-group">
        @foreach (var module in Model)
        {
            <li class="list-group-item">
                @Html.Raw(f(module))
            </li>
        }
    </ul>
    @Html.Raw(globalModuleDivArea)
</div>
