@model IEnumerable<TL.Engine.SDK.Modules.ModuleBase>
@{
    ViewData["Title"] = "Index";

    string f(TL.Engine.SDK.Modules.ModuleBase module)
    {
        var r = "";
        if (!string.IsNullOrWhiteSpace(module.Url))
        {
            r += $"<a class=\"btn btn-outline-secondary\"href=\"{module.Url}\" role=\"button\" " +
                        $"data-toggle=\"tooltip\" data-placement=\"right\" title=\"Доступна веб-часть\">{module.Name}</a>";
        }
        else
        {
            r += $"<button class=\"btn btn-outline-secondary\" disabled>{module.Name}</button>";
        }
        r += $"<p>{module.Description}</p>";
        r += $"<p>{module.Authors}</p>";
        r += $"<p>version {module.Version}</p>";
        r += $"<hr />";
        if (module.SubModules.Any())
        {
            foreach (var sumodule in module.SubModules)
            {
                r += "<div class=\"media mt-3\">";
                r += $"<img src=\"{sumodule.Icon}\" alt=\"Logo\">";
                r += $"<div class=\"media-body\">{f(sumodule)}</div>";
                r += "</div>";
            }
        }
        return r;
    }
}

<div class="jumbotron">
    <h1 class="display-4">Добро пожаловать!</h1>
    <p class="lead">Поздравляем с запуском TL Engine Enterprise!</p>
    <hr class="my-4">
    <p>
        Список доступных модулей TL Engine:
    </p>
    @foreach (var module in Model)
    {
        <div class="media">
            <img class="mr-3" src="@module.Icon" alt="Logo">
            <div class="media-body">
                @Html.Raw(f(module))
            </div>
        </div>
    }
</div>
