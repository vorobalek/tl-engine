@model TL.Engine.Web.ViewModels.Home.IndexViewModel
@{
    ViewData["Title"] = "Добро пожаловать!";
}

<div class="card bg-dark text-white">
    <img class="card-img" src="~/Styles/images/techno_logika_banner.jpg" alt="Card image" style="opacity:0.4">
    <div class="card-img-overlay">
        <h1 class="card-title">Добро пожаловать!</h1>
        <hr />
        <h4 class="card-title">Поздравляем с запуском системы TL Engine!</h4>
        <p class="card-text">
            This is a wider card with supporting text below as a natural lead-in to additional content. This content is a little bit longer.
        </p>
        <p class="card-text">С любовью, <a class="card-link" href="/Account/Profile/vorobalek">@@vorobalek</a></p>
    </div>
</div>
