@model TL.Engine.Web.ViewModels.Shared.LinkViewModel

@if (this.Model.Items.Count() > 0)
{
    var id = string.Join("", Guid.NewGuid().ToString().Split('-'));
    
    <div class="btn-group dropdown">
        <a class="btn btn-link nav-link" href="@Url.Content(Model.Url)" data-toggle="tooltip" data-placement="bottom" title="@Model.Description">
            @Model.Name
        </a>
        <button id="@id" class="btn dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></button>
        <div class="dropdown-menu" aria-labelledby="@id">
            @foreach (var item in this.Model.Items)
            {
                <span class="dropdown-item">
                    <a class="nav-link" href="@Url.Content(item.Url)" data-toggle="tooltip" data-placement="bottom" title="@item.Description">
                        @item.Name
                    </a>
                </span>
            }
        </div>
    </div>
}
else
{
    <a class="btn btn-link nav-link" href="@Url.Content(Model.Url)" data-toggle="tooltip" data-placement="bottom" title="@Model.Description">
        @Model.Name
    </a>
}