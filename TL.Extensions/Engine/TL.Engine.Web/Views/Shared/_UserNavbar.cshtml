@model TL.Engine.Web.ViewModels.Shared.LinksViewModel

<ul class="navbar-nav ml-auto">
    <li class="nav-item dropleft">
        <button class="btn btn-link nav-link align-items-lg-center" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            @if (User.Identity.IsAuthenticated)
            {
                <strong>@User.Identity.Name&nbsp;&nbsp;</strong>
                <img src="~/Styles/images/pack/png/user-3.png" alt="User Logo" width="auto" height="32px" class="shadow rounded-circle" />
            }
            else
            {
                <strong>Аккаунт&nbsp;&nbsp;</strong>
                <img src="~/Styles/images/pack/png/locked-6.png" alt="User Logo" width="auto" height="32px" class="rounded-circle" />
            }
        </button>
        <div class="dropdown-menu" aria-labelledby="accountDropdownMenuLink">
            @if (User.Identity.IsAuthenticated)
            {
                <a class="dropdown-item" href="/Account"><strong>@User.Identity.Name</strong></a>
            }

            @foreach (var item in this.Model.Items)
            {
                <partial name="_UserNavbarItem" model="@item" />
            }

            @if (User.Identity.IsAuthenticated)
            {
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="/Account/Home/Logout">Выход</a>
            }
            else
            {
                <a class="dropdown-item" href="/Account/Login">Вход</a>
                <a class="dropdown-item" href="/Account/Register">Регистрация</a>
            }
        </div>
    </li>
</ul>