@model TL.Engine.Web.ViewModels.Shared.LinksViewModel

@if (this.Model.Items.Count() > 0)
{
    <nav class="nav flex-column nav-pills h6">
        @foreach (var item in this.Model.Items)
        {
            <partial name="_SidebarItem" model="@item" />
        }
    </nav>
}
else
{
    <span></span>
}