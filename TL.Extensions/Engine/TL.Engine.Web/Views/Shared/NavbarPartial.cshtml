<nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top" style="position:absolute">
    <div class="container">
        <a class="navbar-brand brandlabel" href="~/">
            <img src="~/Styles/images/pack/png/app.png" width="30" height="30" class="d-inline-block align-top" alt="">
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">
                        Главная
                    </a>
                </li>
                @foreach (var item in ExtCore.Infrastructure.ExtensionManager.GetInstances<TL.Engine.SDK.Modules.ModuleBase>().Where(it => it.IsNavigationItem).OrderBy(it => it.NavigationOrder))
                {
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Content(item.Url)">
                            @item.DisplayName
                        </a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav justify-content-end">
                @{
                    var spanclass = User.Identity.IsAuthenticated ? " flaticon-locked-3" : "flaticon-locked-2";
                    var prefix = User.Identity.IsAuthenticated ? User.Identity.Name : "";
                }
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        @prefix<span class="@spanclass"></span>
                    </a>
                    <div class="dropdown-menu" aria-labelledby="accountDropdownMenuLink">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a class="dropdown-item" href="/Account">Профиль @User.Identity.Name</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="/Account/Home/Logout">Выход</a>
                        }
                        else
                        {
                            <a class="dropdown-item" href="/Account/Home/Login">Вход</a>
                            <a class="dropdown-item" href="/Account/Home/Register">Регистрация</a>
                        }
                    </div>
                </li>
            </ul>
        </div>
    </div>
</nav>