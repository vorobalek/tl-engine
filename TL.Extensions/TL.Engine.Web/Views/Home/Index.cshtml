@model IEnumerable<TL.Engine.SDK.Modules.ModuleBase>
@{
    ViewData["Title"] = "Index";
}

<div class="jumbotron">
    <h1 class="display-4">Добро пожаловать!</h1>
    <p class="lead">Поздравляем с запуском TL Engine Enterprise!</p>
    <hr class="my-4">
    <p>
        Список доступный модулей TL Engine:
        <ul>
            @foreach (var module in Model)
            {
                <li>
                    @module.Name (@module.Description) - version @module.Version by @module.Authors @module.Url
                    <ul>
                        @foreach (var submodule in module.SubModules)
                        {
                            <li>@submodule.Name (@submodule.Description) - version @submodule.Version by @submodule.Authors @submodule.Url</li>
                        }
                    </ul>
                </li>
            }
        </ul>
    </p>
    <p class="lead">
        <a class="btn btn-primary btn-lg" href="~/Account" role="button">Go to Account</a>
    </p>
</div>
