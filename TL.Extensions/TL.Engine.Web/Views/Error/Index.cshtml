@{
    ViewData["Title"] = "Ошибка!";
}
@model TL.Engine.Web.Models.ErrorViewModel
@{
    var statusCode = Model.StatusCode;
    var statusmessage = "";
    switch (statusCode)
    {
        case 400:
            statusmessage = "Неверный запрос: запрос не может быть выполнен из-за неправильного синтаксиса";
            break;
        case 403:
            statusmessage = "Запрещено";
            break;
        case 404:
            statusmessage = "Страницы не существует";
            break;
        case 408:
            statusmessage = "Вышло время ожидания запроса";
            break;
        case 500:
            statusmessage = "Внутренняя ошибка сервера - серверу не удалось завершить обработку запроса";
            break;
        default:
            statusmessage = "Это странно... Произошло то, чего мы не ожидали";
            break;
    }
}
<div class="jumbotron row">
    <div class="col-2">
        <img src="~/Styles/images/crying_cat.png" alt="Простите:(" width="100%" />
    </div>
    <div class="col-10">
        @if (Model.ShowRequestId)
        {
            <p>
                <strong>Request ID:</strong>
            </p>
            <h5>
                <code>@Model.RequestId</code>
            </h5>
        }
        <h1>Ошибка @Model.StatusCode</h1>
        <h3>@statusmessage</h3>
    </div>
</div>
