@{
    ViewData["Title"] = "История переводов";
}
@model TL.Translator.Web.Areas.Translator.ViewModels.History.HistoryViewModel

<h1>История ваших переводов</h1>
<br />
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Язык перевода</th>
            <th>Текст</th>
            <th>Язык назначения</th>
            <th>Результат</th>
            <th>Дата</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var translate in Model.Histories)
        {
            <partial name="_HistoryItem" model="@translate" />
        }
    </tbody>
</table>
