@model TL.TelegramBots.Web.Areas.TelegramBots.ViewModels.Home.IndexViewModel

<h1>Запустить бота:</h1>
<form id="formbot" asp-anti-forgery="true" class="needs-validation" novalidate>
    <div class="text-danger validation" asp-validation-summary="ModelOnly"></div>
    <div class="form-group">
        <label asp-for="@Model.Token">Токен Бота</label>
        <input type="text" asp-for="@Model.Token" class="form-control" placeholder="Токен" required />
        <div class="valid-feedback">
            Ок
        </div>
        <div class="invalid-feedback">
            Введите токен
        </div>
    </div>
    <div class="form-group">
        <label asp-for="@Model.BotType">Тип бота, пожалуйста</label>
        <select asp-for="@Model.BotType" asp-items="@Model.AvailableTypes" class="form-control" required>
            <option disabled selected>Выберте один из вариантов</option>
        </select>
        <div class="valid-feedback">
            Ок
        </div>
        <div class="invalid-feedback">
            Выберите один из вариантов
        </div>
    </div>
</form>
<div class="form-group">
    <button id="submit" class="btn btn-success" onclick="start($('#formbot').serialize())">
        Запустить
    </button>
</div>
<hr />
<div id="onlinebots">
    <partial name="_OnlineBots" model="@Model.Bots" />
</div>

@section Scripts {
    <script type="text/javascript">

        start = function (args) {
            $.ajax({
                url: '/TelegramBots/Home/Start?' + args,
                type: 'post',
                success: function (result) {
                    $(document).find('#onlinebots').html(result);
                    $('#formbot').find('input').val('');
                    $('#formbot').find('select').prop('selectedIndex', 0);
                }
            })
        }

        kill = function (username) {
            $.ajax({
                url: "TelegramBots/Home/Kill?username=" + username,
                type: "post",
                success: function (result) {
                    $(document).find('#onlinebots').html(result);
                }
            });
        }
    </script>
}