@model System.Collections.Generic.IEnumerable<TL.Account.Data.Entities.Security.UserRole>
@if (Model == null)
{
    <p>
        Вы пока не состоите ни в одной группе.
    </p>
}
else
{
    <h4>Ваши группы: </h4>
    <ul>
        @foreach (var role in Model)
        {
            <li>
                @role.Role?.Name
                <ul>
                    @foreach (var deepUserRole in role.Role?.UserRoles)
                    {
                        <li>@deepUserRole.User?.Username</li>
                    }
                </ul>
            </li>
        }
    </ul>
}