@model TL.Account.Web.Areas.Account.ViewModels.IndexViewModel
@{
    ViewData["Title"] = User.Identity.Name;
}

<div class="row">
    <div class="col">
        <h1>@User.Identity.Name, настройте свой профиль!</h1>
    </div>
</div>
<div class="row">
    <div class="col-8">
        <ul>
            @foreach (var item in Model.Translations)
            {
                <li>
                    <div class="row">
                        <div class="col">@item.InputCulture</div>
                        <div class="col">@item.InputText</div>
                    </div>
                    <div class="row">
                        <div class="col">@item.OutputCulture</div>
                        <div class="col">@item.OutputText</div>
                    </div>
                    <div class="row">
                        <div class="col">@item.Date</div>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>