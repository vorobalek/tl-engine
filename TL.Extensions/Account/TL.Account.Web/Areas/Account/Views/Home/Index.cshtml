@model TL.Account.Web.Areas.Account.Models.IndexViewModel

<h1>Hello, @User.Identity.Name</h1>
<div class="row">
    <div class="col-8">
        @await Component.InvokeAsync("RoleList", Model)
        <ul>
            @foreach (var item in Model.Translations)
            {
                <li>
                    <div class="row">
                        <div class="col">@item.InputCulture</div>
                        <div class="col">@item.InputText</div>
                    </div>
                    <div class="row">
                        <div class="col">@item.OutputCulture</div>
                        <div class="col">@item.OutputText</div>
                    </div>
                    <div class="row">
                        <div class="col">@item.Date</div>
                    </div>
                </li>
            }
        </ul>
    </div>
    @if (!Model.HasPassword)
    {
        <div class="col-4 alert alert-danger" role="alert">
            <p>
                Для вашей учетной записи не указан пароль, установите его ради вашей безопаности!
            </p>
            @await Component.InvokeAsync("SetPassword", new TL.Account.Web.Areas.Account.Models.SetPasswordComponentModel())
        </div>
    }
</div>
<div class="row">
    <a asp-action="BigRedButton" asp-controller="Home" class="btn btn-danger btn-lg" role="button">Big Red Button</a>
    <a asp-action="Exception" asp-controller="Home" class="btn btn-danger btn-lg" class="btn btn-primary btn-lg" role="button">Get Exception!</a>
    <a class="btn btn-primary btn-lg" href="~/Account/Home/Logout" role="button">Logout</a>
</div>