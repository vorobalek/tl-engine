@model TL.Account.Web.Areas.Account.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<h2>Вход на сайт</h2>
<div class="row">
    <div class="col-auto">
        <form asp-action="Index" asp-controller="Login" asp-anti-forgery="true" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="text-danger validation" asp-validation-summary="ModelOnly"></div>
            <div class="form-group">
                <input type="text" asp-for="@Model.Username" class="form-control" placeholder="Логин" />
                <span asp-validation-for="@Model.Username" />
            </div>
            <div class="form-group">
                <input asp-for="@Model.Password" class="form-control" placeholder="Пароль" />
                <span asp-validation-for="@Model.Password" />
            </div>
            <div class="form-group">
                <input type="submit" value="Войти" class="btn" />
            </div>
        </form>

        <a asp-action="Register" asp-controller="Home">Регистрация</a>
    </div>
</div>