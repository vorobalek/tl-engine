@model TL.Account.Web.Areas.Account.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<h2>Регистрация</h2>
<div class="row">
    <div class="col-auto">
        <form asp-action="Index" asp-controller="Register" asp-anti-forgery="true" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="text-danger validation" asp-validation-summary="ModelOnly"></div>
            <div class="form-group">
                <input type="text" asp-for="@Model.Username" class="form-control" placeholder="Логин" />
                <span asp-validation-for="@Model.Username" />
            </div>
            <div class="form-group">
                <input asp-for="@Model.Password" class="form-control" placeholder="Пароль" />
                <span asp-validation-for="@Model.Password" />
            </div>
            <div class="form-group">
                <input asp-for="@Model.ConfirmPassword" class="form-control" placeholder="Повторите пароль" />
                <span asp-validation-for="@Model.ConfirmPassword" />
            </div>
            <div class="form-group">
                <input type="submit" value="Регистрация" class="btn" />
            </div>
        </form>
    </div>
</div>